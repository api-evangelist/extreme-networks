                  "disabled": false,
                  "key": "deviceId",
                  "value": "<long>",
                  "description": "(Required) The device ID for which the \"Device Health\", \"Usage and Capacity\" and \"Client Health\" current number of issues needs to be provided"
                }
              ],
              "variable": []
            },
