        {
          "id": "1b744453-12c1-4c3a-b2b8-a66667d97002",
          "name": "User logout (Revoke the current access token)",
          "request": {
            "name": "User logout (Revoke the current access token)",
            "description": {
              "content": "User logout, the current access token will be revoked and the following access with the same token will be immediately denied.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "logout"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "3284fa0f-e6db-4be8-a3fa-10284cda1af3",
              "name": "OK",
              "originalRequest": {
