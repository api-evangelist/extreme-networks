          "name": "Generate new API token",
          "request": {
            "name": "Generate new API token",
            "description": {
              "content": "Generate a new API token with given permissions and expiration time.  <p> The available permission list can be found via 'GET /auth/permissions' endpoint. <p> User can also provide an optional rate limits parameter to control the rate limiting for the API token.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "apitoken"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
