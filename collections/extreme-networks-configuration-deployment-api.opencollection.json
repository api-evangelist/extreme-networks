{
  "opencollection": "1.0.0",
  "info": {
    "name": "ExtremeCloud IQ Account Configuration - Deployment API",
    "version": "25.9.0-36"
  },
  "items": [
    {
      "info": {
        "name": "Configuration - Deployment",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get list of deployments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.extremecloudiq.com/deployments",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number, min = 1"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Page Size, min = 1, max = 100"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get firmware upgrade details across multiple sites and devices."
        },
        {
          "info": {
            "name": "[LRO] Push configuration and upgrade firmware",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.extremecloudiq.com/deployments",
            "params": [
              {
                "name": "async",
                "value": "",
                "type": "query",
                "description": "Whether to enable async mode"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Push configuration and upgrade firmware to the target devices."
        },
        {
          "info": {
            "name": "Get configuration deployment overview",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.extremecloudiq.com/deployments/overview",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get configuration deployment status overview."
        },
        {
          "info": {
            "name": "Get configuration deployment status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.extremecloudiq.com/deployments/status",
            "params": [
              {
                "name": "deviceIds",
                "value": "",
                "type": "query",
                "description": "The target device IDs"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get configuration deployment status for the target devices."
        },
        {
          "info": {
            "name": "Get device firmware metadatas",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.extremecloudiq.com/deployments/firmware-metadatas",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get the compatible firmware metadatas for the devices."
        },
        {
          "info": {
            "name": "Get details of the deployment by deployment ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.extremecloudiq.com/deployments/:deploymentId",
            "params": [
              {
                "name": "deploymentId",
                "value": "",
                "type": "path",
                "description": "The deployment ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get firmware upgrade schedule details across sites."
        },
        {
          "info": {
            "name": "Update schedule with deployment ID",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.extremecloudiq.com/deployments/:deploymentId",
            "params": [
              {
                "name": "deploymentId",
                "value": "",
                "type": "path",
                "description": "The deployment ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update firmware upgrade across multiple sites."
        },
        {
          "info": {
            "name": "Delete the deployment schedule by ID",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.extremecloudiq.com/deployments/:deploymentId",
            "params": [
              {
                "name": "deploymentId",
                "value": "",
                "type": "path",
                "description": "The deployment ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete firmware upgrade schedule."
        },
        {
          "info": {
            "name": "[LRO] Get firmware deployment status by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.extremecloudiq.com/deployments/:deploymentId/status",
            "params": [
              {
                "name": "deploymentId",
                "value": "",
                "type": "path",
                "description": "The deployment ID"
              },
              {
                "name": "async",
                "value": "",
                "type": "query",
                "description": "Whether to enable async mode"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get firmware upgrade schedule status for a site based on deployment ID."
        }
      ]
    }
  ],
  "bundled": true
}