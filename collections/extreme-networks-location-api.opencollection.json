                "description": "The parent location ID, return root locations if parent is null"
              },
              {
                "name": "expandChildren",
                "value": "",
                "type": "query",
                "description": "Whether to return the child locations recursively, default is true.\nSet it to false to improve performance when there are a lot of child locations."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get location hierarchical tree."
