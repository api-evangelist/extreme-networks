{
  "opencollection": "1.0.0",
  "info": {
    "name": "ExtremeCloud IQ Account Log API",
    "version": "25.9.0-36"
  },
  "items": [
    {
      "info": {
        "name": "Log",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List audit logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.extremecloudiq.com/logs/audit",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number, min = 1"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Page Size, min = 1, max = 100"
              },
              {
                "name": "startTime",
                "value": "",
                "type": "query",
                "description": "The start time to query, epoch time in milliseconds since 1/1/1970"
              },
              {
                "name": "categories",
                "value": "",
                "type": "query",
                "description": "Audit category"
              },
              {
                "name": "username",
                "value": "",
                "type": "query",
                "description": "The user login name"
              },
              {
                "name": "endTime",
                "value": "",
                "type": "query",
                "description": "The end time to query, epoch time in milliseconds since 1/1/1970. Note: endTime - startTime must be no greater than 2592000000 (30 days)"
              },
              {
                "name": "keyword",
                "value": "",
                "type": "query",
                "description": "The case-insensitive keyword to search in description"
              },
              {
                "name": "sortField",
                "value": "",
                "type": "query",
                "description": "The field for sorting"
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "The sort order (ascending by default)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List a page of audit logs."
        },
        {
          "info": {
            "name": "Get audit log full descriptions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.extremecloudiq.com/logs/audit/full-descriptions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get audit log full descriptions by ID."
        },
        {
          "info": {
            "name": "Create audit logs report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.extremecloudiq.com/logs/audit/reports",
            "params": [
              {
                "name": "categories",
                "value": "",
                "type": "query",
                "description": "Audit category"
              },
              {
                "name": "username",
                "value": "",
                "type": "query",
                "description": "The user login name"
              },
              {
                "name": "startTime",
                "value": "",
                "type": "query",
                "description": "The start time to query, epoch time in milliseconds since 1/1/1970, default is 0 if not specified or is negative"
              },
              {
                "name": "endTime",
                "value": "",
                "type": "query",
                "description": "The end time to query, epoch time in milliseconds since 1/1/1970, default is now if not specified or is negative, endTime - startTime must be no greater than 2592000000 (30 days)"
              },
              {
                "name": "timeZoneOffset",
                "value": "",
                "type": "query",
                "description": "The time zone off set"
              },
              {
                "name": "keyword",
                "value": "",
                "type": "query",
                "description": "The case-insensitive keyword to search in description"
              },
              {
                "name": "sortField",
                "value": "",
                "type": "query",
                "description": "The field for sorting"
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "The sort order (ascending by default)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a report page of audit logs."
        },
        {
          "info": {
            "name": "Download audit logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.extremecloudiq.com/logs/audit/reports/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Download report of audit logs."
        },
